generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  nama       String
  email      String   @unique
  password   String
  role       String   @default("user") // "admin" atau "user"
  face_embed String?  @db.Text         // Untuk menyimpan data vektor wajah
  create_at  DateTime @default(now())
  absensi    Absen[]

  @@map("user")
}

model Absen {
  id               String   @id @default(uuid())
  user_id          String
  scan_time        DateTime @default(now())
  device_loc       String
  status           String   // "Hadir", "Terlambat", "Alpa"
  confidence_score Float
  
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("absen")
}
